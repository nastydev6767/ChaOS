<Window x:Class="NexusControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Control Center" Height="760" Width="1180"
        MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1629" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,34">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="N" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="CONTROL CENTER" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,0,0,12"/>
                    <Button Content="◈   Overview" HorizontalContentAlignment="Left" Background="#29375C" Margin="0,0,0,7" Click="Overview_Click"/>
                    <Button Content="▣   Game Library" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="Library_Click"/>
                    <Button Content="⚙   Performance" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="Performance_Click"/>
                    <Button Content="◉   System" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="System_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#18233B" CornerRadius="12" Padding="13" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="NEXUS OS" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Prototype environment" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10"/>
                            <TextBlock Text="Not installed" Foreground="#FFCA7A" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="NEXUS • EARLY PROTOTYPE" Foreground="#71809F" FontSize="9"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28,34,30">
                <DockPanel Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="PageSubtitle" Text="Your gaming environment, at a glance." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#18233B" CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                        <TextBlock Text="●  WINDOWS COMPANION" Foreground="#9FE4C1" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </DockPanel>

                <Border Background="#202D50" CornerRadius="18" Padding="24" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WELCOME TO NEXUS" Foreground="#B8C4FF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="One PC. Two environments." FontSize="25" FontWeight="Bold" Margin="0,9,0,6"/>
                            <TextBlock Text="Keep Windows for compatibility. Use NEXUS OS as a dedicated Linux gaming and desktop environment." Foreground="#C3CDE6" TextWrapping="Wrap" MaxWidth="620"/>
                            <TextBlock Text="This prototype does not install Linux or change your boot configuration." Foreground="#FFD18A" FontSize="11" Margin="0,12,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="92" Height="92" CornerRadius="22" Background="#344675" Margin="20,0,0,0">
                            <TextBlock Text="N" FontSize="58" FontWeight="Bold" Foreground="#E9ECFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CURRENT OS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="OsValue" Text="Windows" FontSize="21" FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="Detected from this session" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="DEVICE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="DeviceValue" Text="Windows PC" FontSize="21" FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="Machine name" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="NEXUS OS STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Not installed" FontSize="21" FontWeight="Bold" Foreground="#FFCA7A" Margin="0,8,0,2"/>
                            <TextBlock Text="Installation is not part of this build" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="2,5,0,11"/>
                <UniformGrid Columns="2">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,9,10">
                        <StackPanel>
                            <TextBlock Text="Launch Steam" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Open your Windows Steam client." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,13"/>
                            <Button Content="Launch Steam  →" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Click="LaunchSteam_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="9,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Windows Settings" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Open the Windows settings application." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,13"/>
                            <Button Content="Open Settings  →" HorizontalAlignment="Left" Click="OpenSettings_Click"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#18233B" CornerRadius="12" Padding="15" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" Text="Ready. NEXUS Control Center is running in prototype mode." Foreground="#B9C7E8" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
